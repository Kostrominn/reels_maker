# LLM API (OpenAI-compatible)
# Рекомендуемый вариант (универсально для open-source провайдеров):
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
#
# Доп. заголовки (опционально, JSON-объект):
# LLM_EXTRA_HEADERS_JSON={"X-Title":"reels-maker","HTTP-Referer":"https://example.com"}
#
# Опционально для OpenRouter (если не хотите использовать LLM_API_KEY):
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_APP_NAME=reels-maker
# OPENROUTER_SITE_URL=https://example.com
#
# Опционально для Gemini (НЕ open-source):
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
#
# Backward compatibility (старые переменные):
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Hugging Face (нужно для longform режима GigaAM через pyannote)
# HF_TOKEN=

# Optional: override default config path
# REELS_MAKER_CONFIG=./config.yaml

# Optional: default output directory override
# REELS_MAKER_STORAGE=./storage

# Optional: fail if proxy is set but unreachable (default: false)
# REELS_MAKER_PROXY_STRICT=1

# Yandex Disk OAuth
# Приватный доступ к Диску через OAuth-токен (не client secret).
# Получите токен в кабинете Яндекс OAuth и вставьте сюда.
# YANDEX_DISK_OAUTH_TOKEN=

# Optional: disable proxies for Yandex Disk API (set to 1)
# REELS_MAKER_YADISK_NO_PROXY=1

# Optional: Yandex Disk API timeout in seconds (default: 30)
# YANDEX_DISK_TIMEOUT=60

# Instagram Graph API (for `python main.py instagram-upload ...`)
# Long-lived user access token with instagram_content_publish permission.
# INSTAGRAM_ACCESS_TOKEN=
# Numeric IG User ID (professional account).
# INSTAGRAM_IG_USER_ID=
# Optional Graph API version for upload calls.
# INSTAGRAM_GRAPH_API_VERSION=v24.0
# Optional HTTP timeout in seconds for Instagram calls.
# INSTAGRAM_HTTP_TIMEOUT=120
